# Ambiente usado por `npm test`.
# As credenciais do MySQL (DBHOST/DBPORT/DBUSER/DBPASSWORD) vêm do .env local
# ou do ambiente do CI. Aqui só trocamos o banco e o segredo do JWT.
DATABASENAME=simplebank_test
JWT_SECRET=segredo-de-testes-nao-use-em-producao
PORT=0
# Sem limite de tentativas durante os testes.
RATE_LIMIT_MAX=100000
