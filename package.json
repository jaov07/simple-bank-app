{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node ./server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "swagger": "node swagger.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:watch": "node --env-file=.env.test --test --test-concurrency=1 --watch \"tests/*.test.js\"",
    "test:coverage": "node --env-file=.env.test --test --test-concurrency=1 --experimental-test-coverage \"tests/*.test.js\"",
    "db:setup": "node scripts/preparar-banco.js",
    "db:baseline": "node scripts/preparar-banco.js --baseline",
    "db:reset": "node scripts/preparar-banco.js --recriar"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API de banco simples com Express, MySQL e JWT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "swagger-autogen": "^2.23.7"
  }
}
